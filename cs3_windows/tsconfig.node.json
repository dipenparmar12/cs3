{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode — the main process is bundled by vite-plugin-electron (Rollup),
       so extensionless relative imports resolve at build time. `nodenext` here
       would demand `.js` suffixes that the bundler neither needs nor emits. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* `.mts` too, or the tests are the one part of `electron/` that nothing
     typechecks — and a test that does not compile is worse than none, because
     it still passes until someone tries to run it. */
  "include": ["vite.config.ts", "electron/**/*.ts", "electron/**/*.mts"]
}
