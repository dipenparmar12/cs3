{
  "name": "cloudstream-desktop",
  "productName": "CloudStream 3 Desktop",
  "private": true,
  "version": "1.0.0",
  "description": "CloudStream 3 Cross-Platform Desktop Application (Windows)",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "node --experimental-require-module node_modules/electron/install.js",
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc -b",
    "test": "node scripts/test-runner.mjs",
    "test:electron": "node scripts/test-runner.mjs",
    "preview": "vite preview",
    "build:runtime": "node ../tools/package/build-runtime.mjs --verify",
    "build:media": "node ../tools/package/build-media-runtime.mjs --verify",
    "electron:build": "npm run build:runtime && npm run build:media && vite build && electron-builder",
    "dist": "node ../tools/package/build-installer.mjs",
    "dist:win": "node ../tools/package/build-installer.mjs --target both",
    "dist:win:fast": "node ../tools/package/build-installer.mjs --fast --target both",
    "dist:installer": "node ../tools/package/build-installer.mjs --target nsis",
    "dist:portable": "node ../tools/package/build-installer.mjs --target portable",
    "e2e:providers": "node ../tools/e2e/provider-e2e.mjs",
    "e2e:network": "node ../tools/e2e/network-resilience.mjs",
    "e2e:sources": "node ../tools/e2e/source-discovery.mjs"
  },
  "//trustedDependencies": "webtorrent pulls in native modules (node-datachannel for WebRTC peers, utp-native for uTP). Their install scripts MUST run or the app fails at runtime with 'Cannot find module node_datachannel.node'. These also need rebuilding per platform/arch against the Electron ABI before packaging.",
  "trustedDependencies": [
    "node-datachannel",
    "utp-native"
  ],
  "dependencies": {
    "chardet": "^2.2.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.10.1",
    "hls.js": "^1.6.18",
    "lucide-react": "^1.31.0",
    "parse-torrent": "^11.0.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shaka-player": "^5.2.6",
    "webtorrent": "^3.0.21",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "author": {
    "name": "CloudStream Desktop contributors"
  },
  "license": "GPL-3.0"
}
